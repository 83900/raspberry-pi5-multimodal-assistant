# Copy to ~/.config/pi-edge-assistant/edge-assistant.env and edit paths/devices.
EDGE_DATA_DIR=%h/.local/share/pi-edge-assistant
EDGE_RUNTIME_DIR=/run/user/1000/pi-edge-assistant
EDGE_HOST=0.0.0.0
EDGE_PORT=8080

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_COMPARE_MODEL=qwen3.5:4b
OLLAMA_CONTEXT=4096
OLLAMA_MAX_TOKENS=192
OLLAMA_TIMEOUT_SECONDS=180

WHISPER_CLI=%h/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=%h/whisper.cpp/models/ggml-base-q5_0.bin

# Find values with: arecord -L and aplay -L
AUDIO_CAPTURE_DEVICE=default
AUDIO_PLAYBACK_DEVICE=default

# Download with: python -m piper.download_voices <voice-name>
PIPER_ZH_VOICE=%h/.local/share/piper/zh_CN-huayan-medium.onnx
PIPER_EN_VOICE=%h/.local/share/piper/en_US-lessac-medium.onnx
TTS_ENABLED=true

CAMERA_WIDTH=640
CAMERA_HEIGHT=480
MEDIA_TTL_SECONDS=600

# Optional phase-2 wake word bridge. Supply a sherpa-onnx command that writes
# the recognized keyword to stdout. The bridge stops KWS before opening arecord.
# WAKEWORD_COMMAND=sherpa-onnx-keyword-spotter ...
WAKEWORD_RECORD_SECONDS=8
